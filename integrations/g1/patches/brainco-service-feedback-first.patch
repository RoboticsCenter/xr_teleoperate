+++ b/test/command_gate_test.cpp
@@ -0,0 +1,92 @@
+#include "command_gate.h"
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+using namespace brainco_gate;
+using namespace std::chrono_literals;
+void check(bool good) { if (!good) throw std::runtime_error("policy assertion failed"); }
+int main() {
+    const auto t = Clock::time_point{} + 10s;
+    Feedback feedback; feedback.valid = true; feedback.read_started = t;
+    feedback.positions.fill(321);
+    const std::vector<float> q(6, .4f), dq(6, .5f);
+    unsigned writes = 0;
+    Six last_q{}, last_dq{};
+    auto send = [&](const Six& p, const Six& s) { ++writes; last_q = p; last_dq = s; };
+    {
+        CommandGate gate(false, 200ms, 100ms);
+        gate.submit(q, dq, t); gate.tick(t, feedback, send);
+        gate.submit({}, {}, t); gate.shutdown(); gate.tick(t, feedback, send);
+        check(writes == 0);
+    }
+    {
+        CommandGate gate(true, 200ms, 100ms);
+        check(gate.tick(t, feedback, send) == Action::None);
+        gate.shutdown(); check(gate.tick(t, feedback, send) == Action::None);
+        check(writes == 0);
+    }
+    {
+        CommandGate gate(true, 200ms, 100ms);
+        gate.submit(q, dq, t);
+        check(gate.tick(t, feedback, send) == Action::Command);
+        check(last_q[0] == 400 && last_dq[0] == 500);
+        auto next = feedback; next.read_started = t + 200ms;
+        check(gate.tick(t + 200ms, next, send) == Action::HoldAttempt);
+        check(gate.fault() == Fault::CommandExpired && last_q[0] == 321 && last_dq[0] == 100);
+        const auto count = writes;
+        gate.submit(q, dq, t + 201ms); gate.shutdown();
+        check(gate.tick(t + 201ms, next, send) == Action::None && count == writes);
+    }
+    for (unsigned bad = 0; bad < 6; ++bad) {
+        CommandGate gate(true, 200ms, 100ms);
+        auto p = q, s = dq;
+        if (bad == 0) p.resize(5);
+        if (bad == 1) p[0] = std::numeric_limits<float>::quiet_NaN();
+        if (bad == 2) p[0] = 1.01f;
+        if (bad == 3) s[0] = 0;
+        if (bad == 4) s[0] = std::numeric_limits<float>::infinity();
+        if (bad == 5) s.resize(7);
+        const auto count = writes;
+        gate.submit(p, s, t); gate.submit(q, dq, t);
+        check(gate.fault() == Fault::InvalidCommand);
+        check(gate.tick(t, feedback, send) == Action::None && count == writes);
+    }
+    for (bool stale : {false, true}) {
+        CommandGate gate(true, 200ms, 100ms);
+        gate.submit(q, dq, t); gate.tick(t, feedback, send);
+        auto broken = feedback; broken.valid = stale;
+        const auto count = writes;
+        check(gate.tick(t + 101ms, broken, send) == Action::None);
+        check(gate.fault() == Fault::FeedbackUnavailable && count == writes);
+        auto recovered = feedback; recovered.read_started = t + 102ms;
+        gate.submit(q, dq, t + 102ms);
+        check(gate.tick(t + 102ms, recovered, send) == Action::None && count == writes);
+    }
+    {
+        CommandGate gate(true, 200ms, 100ms);
+        gate.submit(q, dq, t); gate.tick(t, feedback, send);
+        gate.submit({}, {}, t + 1ms);
+        check(gate.tick(t + 1ms, feedback, send) == Action::HoldAttempt);
+        check(gate.fault() == Fault::InvalidCommand);
+        check(gate.tick(t + 2ms, feedback, send) == Action::None);
+    }
+    {
+        CommandGate gate(true, 200ms, 100ms);
+        gate.submit(q, dq, t); gate.tick(t, feedback, send);
+        gate.shutdown();
+        check(gate.tick(t, feedback, send) == Action::HoldAttempt);
+        check(gate.tick(t, feedback, send) == Action::None);
+    }
+    // Missing tick during a blocking SDK read: late callback cannot hide expiry.
+    for (auto gap : {200ms, 500ms, -1ms}) {
+        CommandGate gate(true, 200ms, 100ms);
+        gate.submit(q, dq, t); gate.tick(t, feedback, send);
+        gate.submit(q, dq, t + gap);
+        check(gate.fault() == Fault::CommandExpired);
+        auto fresh = feedback; fresh.read_started = t + 600ms;
+        check(gate.tick(t + 600ms, fresh, send) == Action::HoldAttempt);
+        gate.submit(q, dq, t + 601ms);
+        check(gate.tick(t + 601ms, fresh, send) == Action::None);
+    }
+    std::cout << "command gate: all policy assertions passed\n";
+}
