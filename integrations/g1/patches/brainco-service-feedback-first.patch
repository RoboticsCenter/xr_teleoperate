@@ -0,0 +1,100 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+namespace brainco_gate {
+using Clock = std::chrono::steady_clock;
+using Six = std::array<uint16_t, 6>;
+enum class Fault { None, InvalidCommand, CommandExpired, FeedbackUnavailable, Shutdown };
+enum class Action { None, Command, HoldAttempt };
+inline const char* name(Fault f) {
+    switch (f) {
+        case Fault::None: return "none";
+        case Fault::InvalidCommand: return "invalid-command";
+        case Fault::CommandExpired: return "command-expired";
+        case Fault::FeedbackUnavailable: return "feedback-unavailable";
+        case Fault::Shutdown: return "shutdown";
+    }
+    return "unknown";
+}
+struct Feedback {
+    Six positions{};
+    std::array<int16_t, 6> speeds{}, currents{};
+    Clock::time_point read_started{};
+    bool valid{false};
+};
+// Send runs under submit's mutex: invalid callbacks cannot race a checked write.
+class CommandGate {
+public:
+    CommandGate(bool enabled, std::chrono::milliseconds timeout,
+                std::chrono::milliseconds feedback_age)
+        : enabled_(enabled), timeout_(timeout), feedback_age_(feedback_age) {
+        if (timeout.count() <= 0 || feedback_age.count() <= 0)
+            throw std::invalid_argument("deadlines must be positive");
+    }
+    void submit(const std::vector<float>& q, const std::vector<float>& dq,
+                Clock::time_point received) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!enabled_ || fault_ != Fault::None) return;
+        // A callback arriving after a missed deadline must not revive the stream.
+        if (seen_command_ && (received < received_ || received - received_ >= timeout_)) {
+            fault_ = Fault::CommandExpired;
+            return;
+        }
+        if (q.size() != 6 || dq.size() != 6) { fault_ = Fault::InvalidCommand; return; }
+        for (unsigned i = 0; i < 6; ++i) {
+            if (!std::isfinite(q[i]) || !std::isfinite(dq[i]) || q[i] < 0 || q[i] > 1 ||
+                dq[i] < 0.001f || dq[i] > 1) { fault_ = Fault::InvalidCommand; return; }
+        }
+        for (unsigned i = 0; i < 6; ++i) {
+            positions_[i] = static_cast<uint16_t>(std::lround(q[i] * 1000.f));
+            speeds_[i] = static_cast<uint16_t>(std::lround(dq[i] * 1000.f));
+        }
+        received_ = received;
+        seen_command_ = true;
+    }
+    void shutdown() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (enabled_ && fault_ == Fault::None) fault_ = Fault::Shutdown;
+    }
+    Fault fault() const { std::lock_guard<std::mutex> lock(mutex_); return fault_; }
+    template<class Send>
+    Action tick(Clock::time_point now, const Feedback& feedback, Send send) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!enabled_) return Action::None;
+        bool fresh = feedback.valid && now >= feedback.read_started &&
+                     now - feedback.read_started <= feedback_age_;
+        for (auto value : feedback.positions) fresh = fresh && value <= 1000;
+        if (fault_ == Fault::None && !fresh) fault_ = Fault::FeedbackUnavailable;
+        if (fault_ == Fault::None && seen_command_ &&
+            (now < received_ || now - received_ >= timeout_)) fault_ = Fault::CommandExpired;
+        if (fault_ != Fault::None) {
+            // Decide once; recovered feedback must not trigger a deferred hold.
+            if (!handled_fault_) {
+                handled_fault_ = true;
+                if (issued_command_ && fresh) {
+                    Six speed{}; speed.fill(100);
+                    send(feedback.positions, speed);
+                    return Action::HoldAttempt;
+                }
+            }
+            return Action::None;
+        }
+        if (!seen_command_) return Action::None;
+        issued_command_ = true; // attempt, never an acknowledgment
+        send(positions_, speeds_);
+        return Action::Command;
+    }
+private:
+    bool enabled_, seen_command_{false}, issued_command_{false}, handled_fault_{false};
+    std::chrono::milliseconds timeout_, feedback_age_;
+    Six positions_{}, speeds_{};
+    Clock::time_point received_{};
+    Fault fault_{Fault::None};
+    mutable std::mutex mutex_;
+};
+} // namespace brainco_gate
