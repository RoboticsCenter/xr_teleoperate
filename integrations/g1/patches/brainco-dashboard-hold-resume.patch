+HandConnection connect_known_hand(const std::string& port, uint8_t slave_id, const char* side) {
+    // Only an initial failed identification is retried. Successful connections
+    // are retained; no alternate endpoint, ID, baud or register write is used.
+    constexpr unsigned attempts = 3;
+    for (unsigned attempt = 1; running && attempt <= attempts; ++attempt) {
+        spdlog::info("{} startup attempt={}/{} port={} id={}", side, attempt, attempts, port, slave_id);
+        auto connection = try_connect_hand(port, slave_id);
+        if (connection.handle) return connection;
+        if (!running || (attempt < attempts && !startup_wait(250))) break;
+    }
+    if (running)
+        spdlog::error("{} startup unavailable port={} id={}; no worker for this side", side, port, slave_id);
+    else
+        spdlog::info("{} startup cancelled port={} id={}; no worker started", side, port, slave_id);
+    return {};
+}
